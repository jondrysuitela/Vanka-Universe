# Vanka Universe - contoh konfigurasi environment (NAMA variabel saja).
# Salin ke `.env.local` (lokal) atau isi lewat dashboard/`wrangler secret put`
# (produksi). JANGAN pernah commit nilai nyata/secret apa pun.
#
# Catatan:
#  - Secret (mis. R2_SECRET_ACCESS_KEY) set via `wrangler secret put <NAMA>`
#    untuk Cloudflare, atau secret store host.
#  - `wrangler dev` memuat `.env.local`; `.dev.vars` untuk secret dev (gitignored).
#  - `MEDIA_STORAGE_DRIVER` kosong TIDAK fail-closed: default = filesystem
#    (node:fs), yang tidak sah di Cloudflare Workers. Wajib diisi `r2`/`db-r2`.

NODE_ENV=

# Origin publik app. Dipakai untuk cek CSRF pada mutasi.
# Contoh: https://contoh-domain.tld . Kosong => pakai url.origin request.
APP_ORIGIN=

# --- Database (Neon / PostgreSQL) ---
# Wajib: "pg" (PostgreSQL lokal via TCP) atau "neon". Nilai lain => error.
DB_DRIVER=
# String koneksi Postgres/Neon. Kosong => server fail-closed
# ("Database is not configured on this server.").
DATABASE_URL=

# --- Penyimpanan media ---
# Wajib (Cloudflare): "r2" (legacy, index JSON) atau "db-r2"
# (metadata di Postgres + byte di R2). Kosong => filesystem (JANGAN untuk Workers).
MEDIA_STORAGE_DRIVER=
# Empat variabel berikut WAJIB bila driver r2/db-r2. Kosong => R2ConfigError.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Opsional tapi penting: bila kosong dipakai prefix default "test/",
# sehingga objek produksi masuk ke prefix test/.
R2_KEY_PREFIX=
# Opsional. Default: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Opsional. Default: <R2_KEY_PREFIX>index.json
R2_METADATA_KEY=

# --- Autentikasi ---
# Opsional. Default 12. Ukuran ini menentukan biaya hash PIN/password.
BCRYPT_COST=

# --- Arsip privat (PIN) ---
# Nama SATU header yang proxy di depan app dijamin selalu menuliskan.
# Untuk Cloudflare Workers: cf-connecting-ip (edge Cloudflare menimpanya;
# tidak bisa dipalsukan client). Kosong => IP tak diketahui dan POST
# /api/archive/access fail-closed 503 ARCHIVE_ACCESS_UNAVAILABLE.
ARCHIVE_TRUSTED_PROXY_HEADER=cf-connecting-ip
